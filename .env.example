# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=https://poskoo.com
# Search indexing is opt-in and fails closed. Leave false (or unset) on staging:
# the site stays noindex and sitemap.xml is empty. Set true ONLY in the approved
# Poskoo production environment, where NEXT_PUBLIC_SITE_URL is exactly
# https://poskoo.com. A missing or non-production URL keeps indexing off.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Optional override for the sitemap last-modified date (ISO 8601). Defaults to a
# fixed staging date; set only when the sitemap content really changed.
SITEMAP_LAST_MODIFIED=

# Cookieless analytics site hostname; leave empty to disable tracking.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Optional script URL; defaults to Plausible when unset.
NEXT_PUBLIC_ANALYTICS_SRC=

# Database (PostgreSQL). Run `npm run db:migrate` after every deploy that adds a db/migrations file.
DATABASE_URL=
DATABASE_SSL=

# 32-byte base64 key for AES-256-GCM token encryption.
TOKEN_ENCRYPTION_KEY=

# Shared secret for the cron job routes (/api/jobs/*), sent as header x-cron-secret.
# Also used by the deploy hook POST /api/jobs/revalidate (scripts/post-deploy-revalidate.sh).
CRON_SECRET=

# Super-admins for the /admin panel (comma-separated emails). Nothing is built in: no admins
# unless listed here. The email must also be verified (Google sign-in, code or reset).
ADMIN_EMAILS=

# Instagram API with Instagram Login (Meta app dashboard).
# Meta app settings to fill in:
#   Valid OAuth redirect URI:     <NEXT_PUBLIC_SITE_URL>/api/instagram/callback
#   Deauthorize callback URL:     <NEXT_PUBLIC_SITE_URL>/api/instagram/deauthorize
#   Data deletion request URL:    <NEXT_PUBLIC_SITE_URL>/api/instagram/data-deletion
#   Webhook callback URL:         <NEXT_PUBLIC_SITE_URL>/api/meta/webhook
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads API app from developers.facebook.com, optional.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# Facebook Login for Business (Instagram via a Facebook Page): the Meta app id and the
# Login for Business configuration id. Both set = the Facebook Login flow is offered.
META_APP_ID=
META_LOGIN_CONFIG_ID=

# Meta webhooks.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Meta App Review demo login. Leave both empty to disable it.
# Give these to Meta in the App Review notes; the reviewer then follows /app/review-guide.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# Claude API key for AI captions and AI DM replies (server only)
ANTHROPIC_API_KEY=
# Optional model override, default claude-haiku-5-5
AI_MODEL=
# Optional higher-quality model for AI ideas, default claude-sonnet-5-5
AI_QUALITY_MODEL=
# 1 = switch AI DM replies on (on hold by default; src/lib/featureReadiness.ts)
AI_REPLIES_ENABLED=

# Composer media uploads. Files are stored on the server and served through signed URLs.
# Defaults to /data/poskoo-media on Linux (repo data/media on Windows).
MEDIA_STORAGE_DIR=
# Secret used to sign public media URLs. Falls back to TOKEN_ENCRYPTION_KEY.
MEDIA_URL_SECRET=
# Free disk space to keep after a media upload, in GB. Default 20.
MEDIA_MIN_FREE_GB=
# Secret used to sign reminder links. Falls back to TOKEN_ENCRYPTION_KEY.
REMINDER_LINK_SECRET=

# Stripe Connect: creators sell digital products (Products / Orders). Leave empty to keep
# payments switched off (pages show "Payments are not switched on yet"; nothing breaks).
# Use a restricted key (rk_...) or secret key (sk_...) of the PLATFORM account. Test mode first.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <NEXT_PUBLIC_SITE_URL>/api/stripe/webhook (whsec_...).
# That endpoint must listen to events on CONNECTED ACCOUNTS (direct charges); see docs/ENV-NEEDED.md.
STRIPE_WEBHOOK_SECRET=
# Optional: preview API version used ONLY to create connected accounts (Express Dashboard +
# Stripe Managed Risk is a Stripe public preview). Default 2026-10-28.preview.
STRIPE_CONNECT_PREVIEW_API_VERSION=
# Not used yet (Checkout is Stripe-hosted); reserved for embedded components.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform fee per sale in basis points (300 = 3%). Default 300.
PLATFORM_FEE_BPS=

# Poskoo's own Pro / Agency subscriptions (same STRIPE_SECRET_KEY, platform account). Prices are found
# by lookup_key: run `node --env-file=.env.local scripts/stripe-setup-billing.mjs` once per Stripe account.
# Signing secret of the "Your account" webhook endpoint <NEXT_PUBLIC_SITE_URL>/api/stripe/billing-webhook
# (NOT the Connect one above). Without it that endpoint answers 503 (the success page still records upgrades).
STRIPE_BILLING_WEBHOOK_SECRET=
# 1 = scripts/stripe-setup-billing.mjs ran on the LIVE account. Paid plans stay "Coming soon" until this,
# the billing webhook secret and a live (sk_live_/rk_live_) key are all set (src/lib/featureReadiness.ts).
STRIPE_BILLING_LIVE_PRICES=
# Testing only: force features on (launch checks skipped) or off, e.g. billing,card_payments,email,ai,ai_replies or all
FEATURE_FORCE_READY=
FEATURE_FORCE_SOON=
# Plan gating of AI ideas, email capture in DMs and click + lead analytics (src/lib/planFeatures.ts).
# Empty = enforced only once paid plans are on sale (billing ready). off = never, on = always (testing).
PLAN_FEATURE_GATING=
# true = Stripe Tax on subscription Checkout (only after a tax registration is active in Stripe).
STRIPE_TAX_ENABLED=
# Optional: Customer Portal configuration id (bpc_...). Default: the one the setup script tagged.
STRIPE_PORTAL_CONFIGURATION_ID=

# Transactional e-mail (SMTP). Unset = nothing is sent (dev prints e-mails to the console).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Poskoo <hello@poskoo.com>
EMAIL_REPLY_TO=
EMAIL_POSTAL_ADDRESS=
# false = skip the new-device sign-in alert e-mail. Default: alerts on.
EMAIL_NEW_DEVICE_ALERTS=

# More networks (2026-11-11). Leave empty to show "Not set up yet" in the Connect dialog.
# Redirect URIs: <NEXT_PUBLIC_SITE_URL>/api/<tiktok|linkedin|pinterest|x>/callback. See docs/ENV-NEEDED.md.
# Bluesky and Mastodon need no keys.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: LinkedIn API version (YYYYMM, default 202605). Set 1 only after Community Management API approval.
LINKEDIN_API_VERSION=
# 1 = enable posting to LinkedIn company Pages (needs Community Management API approval).
LINKEDIN_PAGES_ENABLED=
LINKEDIN_COMPANY_PAGES=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# 1 = use api-sandbox.pinterest.com (Trial access apps).
PINTEREST_SANDBOX=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Sign in with Google / YouTube uploads (redirect <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Business Profile posting (redirect <NEXT_PUBLIC_SITE_URL>/api/gbp/callback, scope business.manage).
# Either GBP_ENABLED=1 to reuse GOOGLE_CLIENT_ID/SECRET, or a separate client below. See docs/ENV-NEEDED.md.
GBP_ENABLED=
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=

# Runtime values provided by the framework/host; normally leave these unset.
# NODE_ENV=development
# NEXT_PHASE=phase-production-build
# TZ=UTC

# ---- 2026-11-24 networks ported from Postiz (src/lib/networks/moreApps.ts). Each card shows
# "Not available yet" until its keys are set. Redirect / callback URL for each:
# https://poskoo.com/api/<network>/callback  (network = reddit, dribbble, vk, kick, whop, mewe, tiktok_business)
# Reddit: https://www.reddit.com/prefs/apps -> "web app" (commercial use needs Reddit's approval).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Dribbble: https://dribbble.com/account/applications/new (shot upload needs a Pro/Player account).
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
# VK ID: https://id.vk.com/about/business/go -> web app (PKCE, no secret needed).
VK_CLIENT_ID=
# Kick: https://kick.com/settings/developer -> create app (scopes user:read channel:read chat:write).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Whop: https://whop.com/dashboard/developer -> app with OAuth (PKCE, public client).
WHOP_CLIENT_ID=
# MeWe developer API (partner access): https://dev.mewe.com
MEWE_APP_ID=
MEWE_API_KEY=
# MEWE_HOST=https://mewe.com
# TikTok API for Business: https://business-api.tiktok.com/portal/apps (separate from TIKTOK_CLIENT_KEY).
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
